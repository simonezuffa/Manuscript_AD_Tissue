dplyr::filter(GroupContrib == "SPF") %>%
dplyr::select(ID, comp1) %>%
inner_join(VIPs_3xtg_wt_colo_Load %>%
dplyr::filter(GroupContrib == "SPF"), by = c("ID" = "ID"))
